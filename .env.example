# Copy to `.env` (or `.env.local`) for local development. Never commit real values.
# Every account variable is optional: leave them unset and the app runs signed-out only.

# --- Analytics / MCP (existing) ---
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=
MCP_SECRET=

# --- Database (Neon Postgres) ---
# Locally, use a Neon *dev branch* (e.g. `dev`), never `main`.
# On Vercel these are set by the Neon integration (previews get their own branch).
# Pooled connection string, used by the app at runtime (host contains `-pooler`)
DATABASE_URL=
# Direct (unpooled) connection string, used by `bun run db:migrate` / drizzle-kit
DATABASE_URL_UNPOOLED=

# --- Better Auth ---
# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app. Local: http://localhost:5173. Ignored in production, which always
# uses https://mlb.theohtani.com. Leave unset on Vercel previews (the preview's own URL is used).
BETTER_AUTH_URL=http://localhost:5173
# Shared by production and previews so previews can sign in via the production callback.
# Generate with: openssl rand -base64 32 (falls back to BETTER_AUTH_SECRET if unset)
OAUTH_PROXY_SECRET=

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
